 .quiz-options button { display: flex; align-items: center; gap: 14px; width: 100%; min-height: 68px; padding: 13px 16px; color: var(--text); border: 1px solid var(--line); border-radius: 12px; background: var(--surface); text-align: left; font-size: 17px; line-height: 1.45; }
