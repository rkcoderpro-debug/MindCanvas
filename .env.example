# Frontend-safe Supabase values. These are publishable values, never service-role keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8787

# Server-only values. Never expose these through VITE_ variables.
PORT=8787
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
WEB_ORIGIN=
EXPERIENTIAL_LABS_BASE_URL=https://api.experientiallabs.ai/v1
EXPERIENTIAL_LABS_API_KEY=
EXPERIENTIAL_LABS_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Server-side priority list. Verify availability for the Google project that owns the key.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_TIMEOUT_MS=25000
GEMINI_RETRIES_PER_MODEL=1
GEMINI_TOTAL_TIMEOUT_MS=120000
GEMINI_RETRY_BASE_MS=1000
# Shared-key fairness controls for one API process.
AI_MAX_CONCURRENT=2
AI_MAX_QUEUE=20
AI_MAX_QUEUE_PER_USER=2
AI_QUEUE_TIMEOUT_MS=30000
MAX_DOCUMENT_BYTES=10485760
